# Variables consumed by docker-compose.yml itself (not by the app containers
# directly — backend/.env and frontend/.env.local hold those). Copy this file
# to .env before running `docker compose up`.

DB_DATABASE=maiisha
DB_USERNAME=maiisha
DB_PASSWORD=change-me

# Base URL the frontend is built against and the URL nginx is reachable on.
NEXT_PUBLIC_API_URL=http://localhost:8080
